{
  "name": "dsh-experimental-sansheng",
  "version": "0.4.1",
  "description": "\u4e09\u7701\u516d\u90e8 (S\u0101n Sh\u011bng Li\u00f9 B\u00f9) mode for DeepSeek Harness: in-session edict, independent review gates, and a dedicated board backed by the session event log rather than a shared directory.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "client.js",
    "compatibility.json",
    "cordis.patch.yml",
    "index.js",
    "scripts/doctor.mjs",
    "src/history.js",
    "src/policy.js"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/policy.js",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sansheng",
    "san-sheng-liu-bu",
    "agent-team",
    "review-gate",
    "session-log"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matcha-cult/dsh-experimental-sansheng.git"
  },
  "homepage": "https://github.com/matcha-cult/dsh-experimental-sansheng#readme",
  "bugs": {
    "url": "https://github.com/matcha-cult/dsh-experimental-sansheng/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
